MONGO_URI=your_mongodb_connection_string
PORT=5000

# Only this email/password can access the admin panel (no public sign-up)
ADMIN_EMAIL=admin@trueworshipglobal.org
ADMIN_PASSWORD=your_secure_password
JWT_SECRET=change_this_to_a_long_random_string

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: comma-separated frontend origins (Vercel *.vercel.app is allowed by default)
# CORS_ORIGINS=https://your-frontend.vercel.app

# Paystack — https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Where Paystack redirects after payment (your live site donate page)
FRONTEND_URL=https://your-frontend.vercel.app
# Optional override for callback URL only
# PAYSTACK_CALLBACK_URL=https://your-frontend.vercel.app/donate

# Hostinger SMTP — newsletter sends from admin mailing list
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@trueworshipglobal.org
SMTP_PASS=your_mailbox_password_here
SMTP_FROM=hello@trueworshipglobal.org
SMTP_FROM_NAME=True Worship Global
# SMTP_REPLY_TO=hello@trueworshipglobal.org
# Public website URL (unsubscribe links in emails)
SITE_URL=https://trueworshipglobal.com
# Public API URL for one-click unsubscribe (your Vercel server URL)
PUBLIC_API_URL=https://trueworshipglobal-server.vercel.app
